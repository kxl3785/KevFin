{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  // Compile from the entry point (and everything it imports) rather than every
  // file under src/. The NAS builds from Portainer's copy of the repo, which can
  // keep files a later commit deleted; an orphan like that must not be able to
  // fail the build. Anything the server runs is reachable from index.ts.
  "files": ["src/index.ts"]
}
