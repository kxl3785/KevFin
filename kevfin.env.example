PORT=3001

# Zillow property values. KevFin tries OpenWeb Ninja first, then falls back to
# APILLOW (so lookups survive OpenWeb Ninja's monthly plan limit). Set either or
# both.
#   1) OpenWeb Ninja — https://www.openwebninja.com
OPENWEBNINJA_KEY=your_openwebninja_key
#   2) APILLOW fallback — https://apillow.co (free tier: 50 requests/month)
APILLOW_KEY=your_apillow_key

# SEC EDGAR fund holdings (country / stock look-through for ETFs and mutual
# funds). SEC rejects anonymous automated tools, so KevFin declares
# "KevFin <this email>" in the User-Agent of its sec.gov requests — and ONLY
# there. Without it KevFin makes no SEC requests. You can also set it from the
# in-app Setup menu (or the Country exposure card); the in-app value is saved to
# the keys file.
# SEC_CONTACT_EMAIL=you@example.com
# Advanced: override the whole User-Agent instead (must include a contact email).
# SEC_EDGAR_UA=YourName you@example.com

# Plaid (used only for Frec + Bilt). OAuth institutions require Production.
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=production

# Override the SQLite DB path (default resolves to /app/data/kevfin.db in the
# container, which lands on the mounted host volume — no change needed normally).
# DB_PATH=/app/data/kevfin.db

# Set to false to disable the automatic midnight net-worth snapshot cron.
# DAILY_SNAPSHOT=false

# The API only answers requests addressed to a local-looking hostname (localhost,
# IP addresses, single-label names like "nas", *.local, *.lan, *.home.arpa,
# *.ts.net) — this blocks DNS-rebinding attacks from websites you visit. If you
# reach KevFin through another name (custom domain, reverse proxy), list it here
# (comma-separated) and restart.
# KEVFIN_ALLOWED_HOSTS=kevfin.example.com
